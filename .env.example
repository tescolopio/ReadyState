# ReadyState configuration. Copy to .env.local (npm) or pass as container env
# (Docker). Everything here is optional in self-hosted mode: keys can also be
# entered in the app's Settings panel, which overrides these per browser.

# self-hosted (default): single user, no sign-in, bring your own keys.
# hosted: the paid online service; requires lib/hosted.ts to be implemented.
# READYSTATE_MODE=self-hosted

# Default provider: groq | google | cerebras | openrouter | ollama | custom
# READYSTATE_PROVIDER=groq
# Model and endpoint overrides for the default provider.
# READYSTATE_MODEL=openai/gpt-oss-120b
# READYSTATE_BASE_URL=

# Provider API keys (set the ones you use).
GROQ_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# CUSTOM_API_KEY=

# Ollama endpoint as seen from the server (docker-compose sets this to the host).
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Local evals only: send every debrief draft, rejected ones included, to an eval
# run with EVAL_CAPTURE_DRAFTS=1 (scripts/eval/README.md). Never on in hosted mode.
# READYSTATE_CAPTURE_DEBRIEF_DRAFTS=1
